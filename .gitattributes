# Normalize line endings: text files are stored and checked out with LF on
# every platform (Windows included), so rustfmt, YAML files and shell scripts
# behave the same everywhere.
* text=auto eol=lf

# Source and config files
*.rs    text diff=rust
*.toml  text
*.slint text
*.md    text diff=markdown
*.yaml  text
*.yml   text
*.json  text
*.py    text diff=python
*.sh    text eol=lf
*.svg   text

# Generated files: collapsed in GitHub diffs, excluded from language statistics
Cargo.lock linguist-generated=true

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
