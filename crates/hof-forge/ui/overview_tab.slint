import { AboutSlint, Button } from "std-widgets.slint";

export component OverviewTab inherits VerticalLayout {
    in property <string> overview-error;

    callback open-log-clicked();
    callback open-games-clicked();
    callback switch-to-blaze-clicked();

    padding: 24px;
    spacing: 16px;

    // Logo banner: takes the space left over by the text and scales to fit it.
    Rectangle {
        background: #000000;
        border-radius: 8px;
        clip: true;
        min-height: 80px;
        vertical-stretch: 1;

        Image {
            source: @image-url("../../../assets/logo.png");
            image-fit: contain;
            width: parent.width;
            height: parent.height;
        }
    }

    Text {
        text: "Hooks on Fire - Forge";
        font-size: 20px;
        font-weight: 700;
    }

    Text {
        text: "Forge is the configuration editor for Hooks on Fire. Use it to manage the hardware devices that hof-blaze controls during gameplay.";
        wrap: word-wrap;
    }

    Text {
        text: "Getting started";
        font-size: 14px;
        font-weight: 700;
    }

    Text {
        text: "1. Device files for supported hardware are included. Put device files for other hardware into the devices folder of your user folder.\n2. Open the Devices tab.\n3. Select a device from the left list and press + to add an instance.\n4. Give the instance a unique name - this is how hof-blaze identifies it.\n5. Select an instance and press Configure to choose its serial port from the connected USB devices.";
        wrap: word-wrap;
    }

    Text {
        text: "Note";
        font-size: 14px;
        font-weight: 700;
    }

    Text {
        text: "hof-forge and hof-blaze cannot run at the same time. Switch between them with the button below, or with Open HoF-forge in the hof-blaze tray menu.";
        wrap: word-wrap;
    }

    Text {
        text: "Misc";
        font-size: 14px;
        font-weight: 700;
    }

    HorizontalLayout {
        spacing: 12px;

        Button {
            text: "Switch to hof-blaze  (Ctrl+B)";
            primary: true;
            clicked => { root.switch-to-blaze-clicked(); }
        }

        Button {
            text: "\u{1F4C4}  Open hof-blaze log  (Ctrl+L)";
            clicked => { root.open-log-clicked(); }
        }

        Button {
            text: "\u{1F4C2}  Open game files folder  (Ctrl+G)";
            clicked => { root.open-games-clicked(); }
        }

        Text {
            text: root.overview-error;
            color: red;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }

    // About: required by the Slint Royalty-free License (AboutSlint must stay visible here).
    HorizontalLayout {
        spacing: 16px;

        Text {
            text: "Hooks on Fire is released under the MIT License. Its user interface is made with Slint, used under the Slint Royalty-free Desktop, Mobile, and Web Applications License 2.0.";
            wrap: word-wrap;
            font-size: 11px;
            vertical-alignment: bottom;
            horizontal-stretch: 1;
        }

        AboutSlint {
            horizontal-stretch: 0;
            vertical-stretch: 0;
            preferred-width: 200px;
            preferred-height: self.min-height;
        }
    }
}
